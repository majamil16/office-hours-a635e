# Keep local development on the deterministic processor.
JELLY_PAYMENT_MODE=local

# Set JELLY_PAYMENT_MODE=jelly to verify wallet payments on Solana.
# The wallet must be controlled by the Office Hours operator.
JELLY_PAYMENT_WALLET_ADDRESS=
HELIUS_RPC_URL=
JELLY_PAYMENT_ASSET=SOL
# Amount charged per checkout, in lamports (1 SOL = 1,000,000,000 lamports).
JELLY_PAYMENT_AMOUNT_LAMPORTS=1000000
