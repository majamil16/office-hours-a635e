# Office Hours bot (Jelly service account used to message hosts/askers)
JELLY_BOT_USERNAME=officehours

# Operator inbox at /ops (required for ops UI)
# Generate: openssl rand -hex 24
OPS_TOKEN=change-me

# Optional separate token for Jelly platform integration (falls back to OPS_TOKEN)
# JELLY_INTEGRATION_TOKEN=

# How to deliver host notifications after checkout:
#   dry-run  — record the message on the order (default; no outbound call)
#   webhook  — POST JSON to JELLY_NOTIFY_WEBHOOK_URL (Slack/email/requestbin)
#   http     — POST to JELLY_DM_API_URL with Authorization: Token <JELLY_BOT_TOKEN>
#
# Jelly's public docs do not yet expose a DM API. Use webhook as a bridge
# until the bot account can call a real messaging endpoint.
JELLY_NOTIFY_MODE=dry-run
JELLY_BOT_TOKEN=
JELLY_DM_API_URL=
JELLY_NOTIFY_WEBHOOK_URL=

# Optional API override
# JELLY_API_BASE=https://api.jellyjelly.com
